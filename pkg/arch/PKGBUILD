pkgname=mcugen
pkgver=3.0.0
pkgrel=1
pkgdesc="Material Color Utilities Generator"
arch=('x86_64')
url="https://github.com/MeghBadonia/mcugen"
license=('MIT')
depends=('glibc')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::https://github.com/MeghBadonia/mcugen/archive/refs/heads/main.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/mcugen-main"
    make
}

package() {
    cd "$srcdir/mcugen-main"
    install -Dm755 build/mcugen "$pkgdir/usr/bin/mcugen"
}
